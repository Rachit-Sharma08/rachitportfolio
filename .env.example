# Copy this file to .env and fill in real values.
# Never commit the actual .env file - it is gitignored.
# NOTE: do NOT prefix RESEND_* with VITE_ - that would expose them in the browser bundle.

# Resend API key (from https://resend.com/api-keys) - used ONLY by the server
# (api/send-email.ts on Vercel). Never prefix it with VITE_.
RESEND_API_KEY=

# Where contact-form emails should be delivered
CONTACT_EMAIL=

# ============================================================================
#  Supabase  (https://supabase.com/dashboard -> your project)
# ============================================================================
# Vite only exposes variables that start with VITE_ to the browser, so the
# project-url / anon-key pair is renamed from the usual NEXT_PUBLIC_* form.
# Both of these are safe in the browser: RLS in Postgres is what actually
# decides who may read and write anything.
#
#   Project URL      -> Project Settings -> Data API -> Project URL
#   anon public key  -> Project Settings -> API Keys -> Project API keys ->
#                       "anon" "public"  (the long one, sb_publishable_...)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The single admin account's email. Used for the client-side redirect/UX only -
# the real authorization is the is_admin() check inside the RLS policies
# (supabase/schema.sql). If these two ever disagree, RLS wins.
VITE_ADMIN_EMAIL=rachitsharma9990888@gmail.com

# ============================================================================
#  Server-only  (Vercel only - NEVER prefix these with VITE_)
# ============================================================================
#   Service role key -> Project Settings -> API Keys -> Project API keys ->
#                       "service_role" "secret"  (starts with sb_secret_...)
#   Bypasses RLS. Used only inside api/*.ts to serve site_settings and
#   site_story to the public site, which RLS deliberately blocks from the browser.
#   scripts/prerender.mjs also reads this at BUILD time, so set it in Vercel or
#   published posts and the About copy will be baked into the static HTML.
SUPABASE_SERVICE_ROLE_KEY=

# The same address, for the server side. api/rebuild.ts compares it against the
# caller's JWT email, so it must match VITE_ADMIN_EMAIL. Keep the two in sync.
ADMIN_EMAIL=rachitsharma9990888@gmail.com

# Vercel -> Project -> Settings -> Git -> Deploy Hooks -> Create.
# The admin panel pings this the moment you publish or unpublish a post, so the
# new slug gets pre-rendered and added to sitemap.xml without a manual deploy.
SITE_REBUILD_HOOK=

# The site's public origin, without a trailing slash. Used by scripts/seo-config.mjs
# for canonical URLs, og:url and sitemap.xml. Optional - it falls back to the
# Vercel production URL. Set it once you get a custom domain.
SITE_URL=https://rachitportfolio-rouge.vercel.app
